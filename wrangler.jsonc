{
  // Cloudflare Workers configuration. Deploy with:  npx wrangler deploy
  "name": "garmin-ai-coach",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    // The Worker runs only for the page itself and for the Garmin relay.
    // Scripts, styles and images are served as plain static files.
    "run_worker_first": ["/", "/index.html", "/garmin", "/garmin/*"]
  },
  // No request logs are kept.
  "observability": { "enabled": false }
}
